---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import GameListing from '../components/GameListing.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllPublishers, getPaginatedGames } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [{ games, page, totalPages, totalGames }, categories, publishers] = await Promise.all([
  getPaginatedGames(db, { page: 1, pageSize: 6 }),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>
      <GameListing
        games={games}
        categories={categories}
        publishers={publishers}
        page={page}
        totalPages={totalPages}
        totalGames={totalGames}
      />
    </div>
  </div>
</Layout>

---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import GameListing from '../../components/GameListing.astro';
import { getDatabase } from '../../lib/db';
import { getAllCategories, getAllPublishers, getPaginatedGames } from '../../lib/games';

export const prerender = true;
const pageSize = 6;

export const getStaticPaths = (async () => {
  const db = getDatabase();
  const { totalPages } = await getPaginatedGames(db, { page: 1, pageSize: 6 });
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}) satisfies GetStaticPaths;

const currentPage = Number(Astro.params.page);
const db = getDatabase();
const [{ games, page, totalPages, totalGames }, categories, publishers] = await Promise.all([
  getPaginatedGames(db, { page: currentPage, pageSize }),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title={`Games - Page ${page} - Tailspin Toys`}>
  <div class="py-8">
    <h1 class="mb-6 text-3xl font-semibold text-slate-100">All Games</h1>
    <GameListing
      games={games}
      categories={categories}
      publishers={publishers}
      page={page}
      totalPages={totalPages}
      totalGames={totalGames}
    />
  </div>
</Layout>

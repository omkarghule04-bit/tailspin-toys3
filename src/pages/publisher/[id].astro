---
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import GameListing from '../../components/GameListing.astro';
import { getDatabase } from '../../lib/db';
import {
    getAllCategories,
    getAllPublisherIds,
    getAllPublishers,
    getGamesByPublisher,
    getPublisherById,
} from '../../lib/games';

export const prerender = true;

export const getStaticPaths = (async () => {
    const ids = await getAllPublisherIds(getDatabase());
    return ids.map((id) => ({ params: { id: String(id) } }));
}) satisfies GetStaticPaths;

const publisherId = Number(Astro.params.id);
const db = getDatabase();
const [publisher, games, categories, publishers] = await Promise.all([
    getPublisherById(db, publisherId),
    getGamesByPublisher(db, publisherId),
    getAllCategories(db),
    getAllPublishers(db),
]);

if (!publisher) {
    return Astro.redirect('/404');
}
---

<Layout title={`${publisher.name} - Tailspin Toys`}>
    <div class="py-8">
        <a href="/" class="text-sm text-blue-400 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500" data-testid="publisher-back-link">
            ← Back to all games
        </a>
        <h1 class="mt-4 text-3xl font-bold text-slate-100" data-testid="publisher-title">{publisher.name}</h1>
        {publisher.description && <p class="mt-3 max-w-3xl text-slate-400" data-testid="publisher-description">{publisher.description}</p>}
        <h2 class="mt-8 mb-6 text-2xl font-medium text-slate-100">Games by {publisher.name}</h2>
        <GameListing
            games={games}
            categories={categories}
            publishers={publishers}
            page={1}
            totalPages={1}
            totalGames={games.length}
        />
    </div>
</Layout>
